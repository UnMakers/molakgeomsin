; ===== 몰락검신 — 조운고을의 나날 (하루 루프) =====
# DayLoop
@ensurevars
@art char:none
@set chain=0
@set nmul=0
@goto MolakOver#Curse if:curse>=100
@goto MolakOver#Taint if:taint>=6
@goto MolakOver#Taint if:taint>0&&hp<=0
@goto #Collapse if:hp<=0&&collapsed<1||hp<=0&&collapsed<2&&f_hajinbond>0&&f_hajindead<1
@goto MolakOver#Exhaust if:hp<=0
; --- 장(章)·비트 --- (며칠 한 바퀴에 이야기 마디는 셋까지)
# BeatCheck
@goto Molak04#Ld0 if:f_wolfdown>0&&rank>0&&rank<=10||f_wolfdown>0&&f_hapbyeok>0&&rank>0&&rank<=30
@goto Molak06#Ripe1 if:curse>=88&&f_oldseen>0&&b_ripe<1
@goto Molak06#Capture if:day>=60&&b_capture<1
@goto #KDebt if:debt>0&&day>=debtday
@goto #KGrudge if:grudge>0&&day>=grudgeday
@goto #ChWolf if:rank>0&&rank<=100&&f_wolfdown<1&&f_wolfinvite<1
@goto #ChSoa if:day>=3&&f_soamet<1&&b_soa<1
@goto #B5 if:day>=5&&b_hajin<1
@goto #B7 if:day>=7&&b_plate<1
@goto #B8 if:day>=8&&b_wanted<1
@goto #B11 if:day>=11&&b_jang<1
@goto #B13 if:day>=13&&f_soamet>0&&f_soadead<1&&b_soatrain<1
@goto #ChUnju if:day>=15&&f_unjudone<1
@goto #B20 if:day>=20&&rank>0&&rank<=500000&&b_fame<1
@goto #ChShr if:day>=22&&f_shrseen<1
@goto #ChBilok if:day>=24&&f_bilok>0&&b_bilok<1
@goto #ChHm if:day>=26&&b_hm<1
@goto #ChAmhyang if:day>=30&&b_amhyang<1
@goto #B32 if:day>=32&&rank>0&&rank<=1000&&b_depart<1&&f_hajindead<1
@goto #ChOld if:day>=36&&b_old<1
@goto #A12 if:day>=12&&f_yongspared>0&&b_yong2<1
@goto #A17 if:day>=17&&b_hajin2x<1&&f_hajindead<1
@goto #A19 if:day>=19&&b_jang2<1
@goto #A21 if:day>=21&&f_soamet>0&&f_soadead<1&&f_shrinedone>0&&b_soa3<1
@goto #A23 if:day>=23&&b_herb2<1
@goto #A24 if:day>=24&&rank>0&&rank<=2000&&f_wolfdown<1&&f_wolfedge<1&&b_chain<1
@goto #A27 if:day>=27&&seen_E_Rival>0&&b_rival2<1
@goto #A28 if:day>=28&&f_soamet>0&&f_soadead<1&&b_soa4<1
@goto #A33 if:day>=33&&f_amhyangknown>0&&b_amh2<1
@goto #A34 if:day>=34&&f_hmsaved>0&&f_ochisaved<1&&b_ochi<1
@goto #A40 if:day>=40&&f_oldseen>0&&b_old2x<1
@goto #BShrFire if:day>=28&&f_shrseen>0&&b_shrfire<1
@goto #BHintShr if:day>=19&&g_redverse>0&&f_shrseen<1&&b_hintshr<1
@goto #BSimK if:curse>=75&&g_end_simma>0&&b_simk<1
@goto #BNetHint if:day>=56&&b_nethint<1&&b_capture<1
@goto #BNetK if:day>=57&&g_end_pobak>0&&b_netk<1&&b_capture<1
@goto #BS6 if:day>=16&&f_soamet>0&&f_soadead<1&&aff>=1&&b_s6<1
@goto #BS7 if:day>=30&&f_soamet>0&&f_soadead<1&&aff>=3&&b_s7<1
@set dice=random(1,100)
@goto #BS1 if:day>=5&&f_soamet>0&&f_soadead<1&&b_s1<1&&dice<=85
@goto #BR1 if:day>=6&&b_r1x<1&&dice>=10
@goto #BS2 if:day>=9&&f_soamet>0&&f_soadead<1&&b_s2<1&&dice<=90
@goto #BR2 if:day>=12&&f_janginfo>0&&b_r2x<1&&dice>=5
@goto #BS3 if:day>=18&&f_soamet>0&&f_soadead<1&&aff>=2&&b_s3<1&&dice<=90
@goto #BR3 if:day>=19&&b_r2x>0&&b_r3x<1&&dice>=10
@goto #BS4 if:day>=24&&f_soamet>0&&f_soadead<1&&b_s4<1&&dice<=95
@goto #BR4 if:day>=27&&b_r3x>0&&b_r4x<1&&dice>=5
@goto #BS5 if:day>=30&&aff>=4&&f_soasaved>0&&f_soadead<1&&b_s5<1
@goto #BR5 if:day>=34&&b_r4x>0&&b_r5x<1
@goto #BS1 if:day>=9&&f_soamet>0&&f_soadead<1&&b_s1<1
@goto #BR1 if:day>=10&&b_r1x<1
@goto #BR2 if:day>=17&&f_janginfo>0&&b_r2x<1
@goto #BR3 if:day>=24&&b_r2x>0&&b_r3x<1
@goto #BR4 if:day>=32&&b_r3x>0&&b_r4x<1
@goto #BKnot if:day>=raidday-3&&b_knot<1&&f_gaeknot>0&&f_gaesold<1&&rep_gae>=2
@goto #BKnotK if:day>=raidday-3&&b_knot<1&&g_know_gaeknot>0&&f_gaeknot<1
@goto #BS8 if:day>=raidday&&f_soamet>0&&f_soadead<1&&aff>=2&&b_s8<1
@goto #BH1 if:day>=45&&f_wolfdown<1&&b_hunt1<1
@goto #BH2 if:day>=50&&f_wolfdown<1&&b_hunt2<1
@goto #BH3 if:day>=55&&f_wolfdown<1&&b_hunt3x<1
; --- 아침 풍경 ---
@scene id:day
@vfx kind:rainoff
@goto #MTaint if:taint>0
@goto #MTh if:theme>0&&day>=thday
@pickflavor pool:morning
@goto #M2 if:mrand==2
@goto #M3 if:mrand==3
@goto #M4 if:mrand==4
@goto #M5 if:mrand==5
@goto #M6 if:mrand==6
@goto #M7 if:mrand==7
@goto #M8 if:mrand==8
@goto #M9 if:mrand==9
@goto #M10 if:mrand==10
@goto #M11 if:mrand==11
@goto #M12 if:mrand==12
@goto #M13 if:mrand==13
@goto #M14 if:mrand==14
@goto #M15 if:mrand==15
@goto #M16 if:mrand==16
@goto #M17 if:mrand==17
@goto #M18 if:mrand==18
@goto #M19 if:mrand==19
@goto #M20 if:mrand==20
@goto #M21 if:mrand==21
@goto #M22 if:mrand==22
@goto #M23 if:mrand==23
@goto #M24 if:mrand==24
@goto #M25 if:mrand==25
@goto #M26 if:mrand==26
@goto #M27 if:mrand==27
@goto #M28 if:mrand==28
@goto #M29 if:mrand==29
@goto #M30 if:mrand==30
@goto #M31 if:mrand==31
@goto #M32 if:mrand==32
@goto #M33 if:mrand==33
@goto #M34 if:mrand==34
@goto #M35 if:mrand==35
@goto #M36 if:mrand==36
@goto #M37 if:mrand==37
@goto #M38 if:mrand==38
@goto #M1
# MTaint
@goto #MTaint3 if:taint>=4
@goto #MTaintR if:taintkind==2
세숫물에 비친 입술이 푸르스름하다. 손끝이 저리다. 독이 아직 피 속에 있다.
@goto #Daytime
# MTaintR
옆구리 상처를 싸맨 무명이 누렇게 젖었다. 열이 난다. 상처가 아물 생각을 하지 않는다.
@goto #Daytime
# MTaint3
<color=#C03434>일어나는 데 한참이 걸린다.</color> 손톱 밑이 검다. 하진무가 문간에서 혀를 찬다.
"객, 오늘은 백초당부터 가시오. 내일은 늦소."
@goto #Daytime
# MTh
@set thday=day+random(4,7)
@set tr=random(1,2)
@goto #MTh1b if:theme==1&&tr==2
@goto #MTh1a if:theme==1
@goto #MTh2b if:theme==2&&tr==2
@goto #MTh2a if:theme==2
@goto #MTh3b if:theme==3&&tr==2
@goto #MTh3a if:theme==3
@goto #MTh4b if:tr==2
# MTh4a
골목 담장에 늑대 발톱 자국 셋. 밤사이 누가 긁고 갔다. 거지 아이들이 그 앞을 돌아서 다닌다.
@goto #Daytime
# MTh4b
혈랑대 척후 둘이 객잔 앞 국숫집에 앉아 있다. 국수는 손도 대지 않았다. 객잔 이층 창만 본다.
@set f_wanted=1
@goto #Daytime
# MTh1a
비. 며칠째다. 마당 우물이 넘친다. 개울 쪽에서 누가 아이 이름을 부른다.
@goto #Daytime
# MTh1b
빗속에 검을 간다. 숫돌이 미끄럽다. 오늘 비무판은 디딤이 무를 것이다.
@goto #Daytime
# MTh2a
저잣거리가 한산하다. 문 닫은 가게마다 흰 종이가 붙었다. 백초당 앞에만 줄이 길다.
@fx hp:-1
@goto #Daytime
# MTh2b
밤새 기침 소리를 들었다. 옆방 손님이 새벽에 실려 나간다. 하진무가 그 방 문을 열어 두고 식초를 뿌린다.
@goto #Daytime
# MTh3a
징세조가 아침부터 어물전을 턴다. 붉은 끈 다섯. 장꾼들이 좌판을 걷는다. 걷지 못한 좌판은 엎어진다.
@goto #Daytime
# MTh3b
하진무가 주판을 오래 튕긴다. 셈이 안 맞는 얼굴이다. 방값 이야기는 꺼내지 않는다. 그래서 더 무겁다.
@goto #Daytime
# M1
운락객잔의 아침. 장작 냄새와 어제 비 냄새가 마당에 남아 있다.
@goto #Daytime
# M2
국밥 끓는 냄새에 눈을 뜬다. 허기가 먼저 일어나 있다.
@goto #Daytime
# M3
하진무가 주판알을 튕기다 말고 당신의 안색부터 살핀다. 일 년을 간호하며 든 버릇이다.
@goto #Daytime
# M4
멀리 북쪽 하늘이 유난히 검다. 혈마곡이 있는 방향이다.
@goto #Daytime
# M5
우물가 아낙들이 목소리를 낮춘다. 또 누가 서열전에서 죽은 모양이다.
@goto #Daytime
# M6
점소이가 마당을 쓸다 말고 꾸벅 고개를 숙인다. 어제보다 깊다. 소문이 도는 모양이다.
@goto #Daytime
# M7
밤새 비가 다녀갔다. 처마 끝 물방울이 수를 세듯 고르게 떨어진다.
@goto #Daytime
# M8
관도 쪽에서 말발굽 소리. 붉은 끈을 맨 전령이 북쪽으로 달려간다.
@goto #Daytime
# M9
창호지에 빛이 번진다. 일 년을 누워 올려다보던 천장이 오늘은 조금 낮아 보인다.
@goto #Daytime
# M10
마당에서 점소이가 닭 모가지를 비튼다. 그것을 끝까지 지켜본다.
@goto #Daytime
# M11
객잔 앞 느티나무에서 까치가 운다. 반가운 소식이 올 징조라며 점소이가 웃는다.
@goto #Daytime
# M12
아침 저자로 나가는 장사치들 틈에 붉은 끈 하나가 섞여 걷는다.
@goto #Daytime
# M13
아침 햇빛 아래서 가슴의 문양이 희미하다. 밤이 오면 다시 달아오를 것이다.
@goto #Daytime
# M14
세숫물에 얼굴을 비춘다. 일 년 전의 얼굴은 거기 없다.
@goto #Daytime
# M15
아침부터 객잔 앞을 서성이는 낯선 그림자. 하진무가 마당을 쓸며 빗자루 끝으로 슬쩍 그자를 밀어낸다.
@goto #Daytime
# M16
저잣거리 개들이 평소보다 사납게 짖는다. 밤새 무언가 지나간 모양이다.
@goto #Daytime
# M17
아침 안개가 짙다. 열 걸음 앞이 보이지 않는다. 검을 쥔 손이 먼저 깨어 있다.
@goto #Daytime
# M18
담 위에 쌍검 자국 같은 흠집이 새로 나 있다. 소아가 다녀갔는지, 바람이 긁고 갔는지.
@goto #Daytime
# M19
점소이가 조심스레 묻는다. "객관님, 정말 북쪽으로 가십니까요." 대답 대신 국밥 그릇을 비운다.
@goto #Daytime
# M20
아침부터 가슴이 미지근하다. 문양이 자라는 날은 몸이 먼저 안다.
@goto #Daytime
# M21
낯선 무인 하나가 마당 건너편에서 당신의 서열 패를 흘끔거린다. 오를수록 등 뒤의 눈이 는다.
@goto #Daytime
# M22
하진무가 방값 장부를 넘기다 당신 이름 칸에서 손을 멈춘다. 쌓인 날짜가 너무 많다.
@goto #Daytime
# M23
아침 바람이 차다. 계절이 바뀐다. 남은 계절이 몇이나 될지는 세어 보지 않는다.
@goto #Daytime
# M24
가슴의 문양이 쇄골 쪽으로 손가락 한 마디쯤 기어올랐다. 옷깃을 여민다.
@goto #Daytime
# M25
마당의 느티나무 잎이 절반쯤 졌다. 떨어진 잎을 세듯 남은 날을 센다.
@goto #Daytime
# M26
새벽에 누가 창에 돌을 던졌다. 창호지에 구멍 하나. 내다보니 아무도 없다.
@goto #Daytime
# M27
눈을 뜨니 손이 검자루를 쥐고 있다. 잠결에 쥔 것이다.
@goto #Daytime
# M28
하진무가 말없이 국밥에 고기 한 점을 더 얹는다. 셈 밝은 영감이 셈을 틀린다.
@goto #Daytime
# M29
맞은편 전각 용마루 위에 사람이 서 있다. 다시 보니 비둘기 한 마리뿐이다. 그런데 가슴의 문양이 한 박자 늦게 식는다.
@goto #Daytime
# M30
찻집 건너편 자리에 백발의 뒷모습. 끝내 돌아보지 않는다. 잔을 비우고 일어서니 자리는 비었고, 찻값만 놓여 있다. 두 잔 값.
@goto #Daytime
# M31
비무판 구경꾼 틈에 복면 하나가 섞여 있다. 아무도 그를 보지 않는다. 그는 당신만 본다. 몇 번째 생인지 세는 눈이다.
@goto #Daytime
# M32
새벽 마당, 느티나무 아래 발자국 하나. 들어온 자국만 있고 나간 자국은 없다. 하진무가 말없이 빗자루로 지운다.
@goto #Daytime
# M33
세수를 하다 멈춘다. 물에 비친 쇄골 아래 획이 보인다. 어제까지는 열뿐이었다. 오늘은 글자다.
@goto #Daytime
# M34
옷을 갈아입다 점소이와 눈이 마주친다. 아이가 황급히 고개를 돌린다.
@goto #Daytime
# M35
아침 운기 대신 가슴에 손을 얹는다. 뛰는 것이 둘이다. 하나는 심장이고, 하나는 박자가 다르다.
@goto #Daytime
# M36
문양이 목까지 올라왔다. 하진무가 아침 인사 대신 옷깃을 여며 준다. 그 손이 떨리는 것을 둘 다 모른 척한다.
@goto #Daytime
# M37
소아가 마당에서 기다리고 있다. 말없이 제 목도리를 풀어 당신 목에 감는다. "추워 보이는군." 거짓말이다. 그녀는 거짓말을 할 때 눈을 피하지 않는다.
@goto #Daytime
# M38
국밥을 뜨다 손이 멎는다. 손가락 끝이 <color=#9A70C4>먹빛</color>이다. 씻어도 지워지지 않는다.
@goto #Daytime

# Daytime
@pickevent chance:85 slot:day
@gosub #RunEvent if:nextevent!="none"
@pickevent chance:40 slot:day
@gosub #RunEvent if:nextevent!="none"
@goto #Night

# AfterChapter
@art char:none
@set chain=chain+1
@goto #BeatCheck if:chain<3
@goto #Night

;
; ---------- 쓰러짐: 한 생에 한 번, 하진무가 업어 온다 ----------
# Collapse
@set collapsed=collapsed+1
@page
@goto #Collapse3 if:f_hajindead>0
@goto #CollapseB if:collapsed>=2
@set tr=random(1,3)
@goto #Collapse2 if:tr==2
@goto #Collapse3 if:tr==3
눈을 뜬다. 운락객잔의 그 방. 일 년을 누워 있던 그 천장이다.
"객이 저자 골목에 엎어져 있더이다. 점소이가 업어 왔소." 하진무가 미음 그릇을 내려놓는다. "이틀을 잤소. 또 일 년은 안 되오."
@goto #CollapseT
# Collapse2
누군가 등에 업혀 있다. 흔들린다. 늙은 등이다. 주판 냄새가 난다.
"내려놓지 않으리다. 한 번 업어 본 몸이라, 무게는 아오."
다음에 눈을 뜨니 이틀이 지나 있다.
@goto #CollapseT
# Collapse3
백초 할멈의 약연 소리에 눈을 뜬다. 쓴 탕약 냄새.
"죽으려거든 내 약값부터 치르고 죽거라." 할멈이 사발을 입에 들이민다. "이틀이다. 다음엔 안 깨어날 게다."
# CollapseB
등에 업혀 있다. 늙은 등이다. 지난번보다 숨이 가쁘다.
"객. 두 번은 업어 드리겠다고 장부에 적어 두었소. 세 번은…… 이 늙은 등이 못 하오."
@goto #CollapseT
# CollapseT
<color=#C03434>다음에 또 쓰러지면, 업어 올 사람이 없다.</color>
@set hp=hpmax/2
@fx day:2 mn:-3
@goto #DayLoop
;
; ---------- 업보: 빚 ----------
# KDebt
@art char:none
해 질 녘, 객잔 마당에 낯선 사내 셋이 들어선다. 맨 앞의 사내가 장부를 펼친다.
"고리대 왕삼 어른 댁에서 왔소. {debt}냥. 오늘이오."
사내의 허리에 녹슨 쇠고리 하나가 매달려 있다. "왕삼 어른 댁 빚은 끝에 가서 고리로 셈하오. 고리 하나에 열 냥. 혈쇄문 폐철장에서."
@set g_fac_swe=1
하진무가 주판을 내려놓는다. 점소이가 부엌으로 숨는다.
@goto #KDebtC if:debtext<1
사내가 장부를 손등으로 친다. "사흘 전에도 이 얼굴이었지. 오늘은 사흘이 없소."
# KDebtC
@choice "전낭을 던진다 — 빚을 갚는다 (은자 {debt})" if:mn>=debt goto:#KDebtPay
@choice "\"사흘만 주시오.\" — 이자 열 냥이 붙는다" if:debtext<1 goto:#KDebtExt
@choice "왼손 새끼손가락을 탁자에 올린다" if:f_finger<1 goto:#KDebtFinger
@choice "그때 살려 보낸 비무꾼이 사내들 뒤에 서 있다" if:f_sparedally>0 goto:#KDebtAlly
@choice "검을 뽑는다" goto:#KDebtFight
@stop
# KDebtPay
전낭이 장부 위에 떨어진다. 사내가 은자를 세고, 이름 위에 줄을 긋는다.
"셈이 바른 분이로군. 또 뵙지 맙시다."
@set mn=mn-debt
@set debt=0
@set debtext=0
@goto #Night
# KDebtExt
사내가 장부에 줄 하나를 더 긋는다. "사흘. 이자 열 냥. 다음엔 손가락이오."
문을 나서며 사내가 하진무의 주판을 한 번 툭 친다. 주판알이 바닥에 흩어진다.
@set debt=debt+10
@set debtday=day+3
@set debtext=1
@goto #Night
# KDebtFinger
@set g_know_wangsam=1
사내가 단도를 꺼낸다. 하진무가 고개를 돌린다.
소리는 생각보다 작다. 검 쥐는 손이 아니라서 다행이라고, 그렇게 여기기로 한다.
사내가 손가락을 무명에 싸서 품에 넣는다. "장부와 맞춰 보아야 해서."
@fx sw:-3 hp:-2
@set f_finger=1
@set debt=0
@set debtext=0
@goto #Night
# KDebtAlly
비무판에서 살려 보낸 사내가 맨 뒤의 수하 어깨에 손을 얹는다. 수하가 돌아보고, 얼굴이 굳는다.
"이분 장부는 내가 왕삼 어른과 따로 셈하겠네. 오늘은 돌아가게."
셋이 장부를 덮는다. 사내는 당신 쪽을 보지 않고 나간다. 빚 하나가 다른 빚을 지웠다.
@set f_sparedally=0
@set debt=0
@set debtext=0
@goto #Night
# KDebtFight
@set dkind="debt"
@gosub MolakDuel#Run
@goto #KDebtW if:duelwin>0
셋은 피를 보고 물러간다. 장부는 그대로 들고.
"이틀. 그다음엔 칼잡이를 더 데려오겠소."
@set debtday=day+2
@set debtext=1
@goto #NightEnd
# KDebtW
둘이 마당에 눕는다. 남은 하나가 장부를 버리고 달아난다.
장부를 주워 불에 넣는다. 다른 이름들도 같이 탄다. 왕삼이 이 일을 잊을 리 없다.
@fx sl:2
@set debt=0
@set debtext=0
@set f_wangsam=1
@set grudgeday=day+random(4,7) if:grudge<1
@set grudge=grudge+1
@goto #NightEnd

; ---------- 업보: 원수 ----------
# KGrudge
@art char:none
@goto #KGrWarn if:grudgewarned<1
@set grudge=grudge-1
@set grudgewarn=0
@goto #KGrA if:f_alms>0||f_thiefkid>0||f_beggarnet>0
@scene id:night
밤. 등잔을 끄려는데 창호지에 그림자가 셋 비친다.
무엇인가 문살을 뚫고 들어와 어깨를 스친다. 소매가 젖는다.
@fx hp:-3
@goto #KGrC
# KGrWarn
@set grudgewarned=1
@set grudgeday=day+random(4,7)
@scene id:night
@art scene:mourners
@set tr=random(1,2)
@goto #KGrWarn2 if:tr==2
새벽. 객잔 문짝에 흰 삼베 띠가 매여 있다. 상복을 짓고 남은 천이다. 띠 끝에 먹으로 이름 석 자가 적혀 있다.
비무판에서 목을 친 그 사내의 이름이다. 그날은 묻지도 않았던.
점소이가 띠를 풀려다가 손을 멈춘다. "객관님, 이건…… 함부로 풀면 안 되는 거라던데요."
@goto #KGrWarnC
# KGrWarn2
밤. 문살을 뚫고 화살 하나가 들어와 베개에 박힌다. 어깨를 스치고 지나간 자리가 뜨겁다.
화살대에 흰 삼베가 감겨 있다. 풀어 보니 이름 석 자. 비무판에서 목을 친 그 사내다.
지붕 위에서 기와 밟는 소리가 멀어진다. 쫓아오라는 소리가 아니다. 기다리라는 소리다.
@fx hp:-2
# KGrWarnC
<color=#C03434>상복이 찾아온다.</color> 오늘은 이름만 놓고 갔다. 다음엔 목을 받으러 온다.
@choice "띠를 풀어 품에 넣는다 — 그 이름을 외운다" goto:#KGrWarnA
@choice "\"찾아오기 전에 내가 가겠다.\" — 상가(喪家)를 찾아간다" goto:#KGrWarnB
@choice "은자를 싸서 상가 대문 앞에 둔다 (은자 10)" if:mn>=10 goto:#KGrWarnC2
@stop
# KGrWarnA
띠를 품에 넣는다. 이름 석 자를 입속으로 한 번 굴려 본다. 목을 칠 때는 몰랐던 이름이다.
그날 밤부터 잠을 얕게 잔다. 기와 소리에 먼저 눈이 떠진다.
@set grudgewarn=1
@goto #Daytime
# KGrWarnB
상가는 저잣거리 끝 골목에 있다. 대문에 조등(弔燈)이 걸려 있다. 안에서 곡소리가 난다. 늙은 여자 하나, 어린 것 둘.
대문 앞에 선다. 상복 입은 사내 하나가 나와 당신 얼굴을 본다. 칼은 뽑지 않는다. 여기는 상가다.
@set tr=random(1,100)
@goto #KGrWarnB2 if:tr<=40+sl*2
"…상가에서는 칼을 안 뽑는 법이다. 사흘 뒤에 오마. 그때는 법이 없다."
사내가 대문을 닫는다. 곡소리가 다시 커진다.
@set grudgewarn=1
@goto #Daytime
# KGrWarnB2
사내가 한참 당신을 본다. 그러다 대문 안쪽을 돌아본다. 늙은 여자가 상주 자리에서 고개를 젓는다.
"……어머니가 그만두라신다. 비무판에서 진 놈 목을 친 놈을 찾아다니다 또 하나 죽으면, 곡할 사람이 없다고."
사내가 이를 악문다. 대문이 닫힌다. 원한은 남았다. 칼만 거두어졌다.
@set grudge=grudge-1
@fx curse:-1
@goto #Daytime
# KGrWarnC2
은자 열 냥을 흰 보자기에 싸서 상가 대문 앞에 둔다. 두드리지 않는다.
이튿날 아침, 보자기는 없다. 문짝의 흰 띠도 없다. 받았다는 뜻인지, 더 기다리겠다는 뜻인지는 모른다.
@fx mn:-10
@set tr=random(1,100)
@set grudge=grudge-1 if:tr<=60
@goto #Daytime
# KGrA
해 질 녘, 골목 아이 하나가 객잔 담 너머로 고개만 내민다.
"나리, 오늘 밤 지붕 위에 사람이 있소. 셋. 상복을 입었소."
아이는 대답도 듣지 않고 사라진다. 밤이 되자 정말로 기와가 운다.
@set grudgewarn=1
@scene id:night
# KGrC
@art scene:mourners
@goto #KGrO if:f_orphan>0
마당에 흰 상복 셋이 선다. 맨 앞의 사내가 칼을 뽑는다.
"비무판에서 네가 벤 사람의 이름을 아느냐."
@goto #KGrCh
# KGrO
마당에 흰 상복 셋이 선다. 그 뒤에 열두어 살 먹은 아이가 검집을 안고 있다. 그날의 그 아이다.
"사부의 신발을 들고 우리를 찾아왔다. 피가 아직 다 안 말랐더군."
# KGrCh
@choice "\"모르오. 알 까닭도 없었소.\" — 검을 뽑는다" goto:#KGrFight
@choice "지붕으로 뛰어 달아난다" if:hp>=6 goto:#KGrRun
@choice "소리쳐 객잔 사람들을 깨운다" goto:#KGrWake
@choice "그때 살려 보낸 비무꾼이 담 위에 앉아 있다" if:f_sparedally>0 goto:#KGrAlly
@choice "동쪽 처마 밑 그늘로 먼저 간다 — 상복은 지붕 동쪽으로 내려온다" if:g_end_wonsu>0 goto:#KGrAmb
@stop
# KGrAmb
<color=#9A70C4>지난 생, 셋은 동쪽 처마에서 차례로 뛰어내렸다. 맨 끝의 하나가 늘 반 박자 늦었다.</color>
처마 밑 그늘에 등을 붙인다. 첫 발이 기와 끝에 닿는 소리. 둘째. 셋째는 아직이다.
@set f_mournambush=1
# KGrFight
@set dkind="grudge"
@gosub MolakDuel#Run
@goto #KGrW if:duelwin>0
목숨만 건졌다. 셋은 피를 보고 물러난다. 오늘은 그것으로 족하다는 듯이.
"그믐 전에 다시 온다. 그때는 넷이다."
@set grudgeday=day+random(3,6) if:grudge<1
@set grudge=grudge+1
@goto #NightEnd
# KGrW
셋이 마당에 눕는다. 피는 새벽까지 마르지 않는다. 하진무가 아무 말 없이 우물물을 길어 온다.
@fx sl:1
@set tr=random(1,100)
@goto #NightEnd if:tr>30
죽은 자의 품에서 쪽지가 나온다. 이름이 넷 적혀 있다. 셋은 마당에 누웠다.
@set grudgeday=day+random(6,10) if:grudge<1
@set grudge=grudge+1
@goto #NightEnd
# KGrRun
기와를 밟고 지붕 셋을 건넌다. 상처가 벌어진다.
@fx hp:-2
@set tr=random(1,100)
@goto #KGrRunF if:tr<=45
새벽에 돌아오니 방이 엉망이다. 이불이 칼에 갈가리 찢겼다. 전낭이 없다.
피한 것이 아니다. 미룬 것이다.
@set mn=0
@set grudgeday=day+random(2,4) if:grudge<1
@set grudge=grudge+1
@goto #NightEnd
# KGrRunF
네 번째 지붕에서 기와가 미끄러진다. 골목 바닥에 떨어진다. 일어서니 앞뒤가 다 상복이다.
@goto #KGrFight
# KGrWake
@goto #KGrWakeD if:f_hajinhurt>0
"불이야!" 소리에 객잔이 깬다. 점소이가 징을 치고, 하진무가 장작개비를 들고 마당에 나선다.
상복 셋이 물러난다. 물러나면서 맨 끝의 하나가 하진무의 팔을 긋는다.
새벽, 하진무의 팔에 무명이 감긴다. 그는 아무 말도 하지 않는다. 원수는 아직 거리에 있다.
@set f_hajinhurt=1
@fx mn:-4
@set grudgeday=day+random(3,6) if:grudge<1
@set grudge=grudge+1
@goto #NightEnd
# KGrWakeD
"불이야!" 소리에 객잔이 깬다. 점소이가 징을 친다. 하진무가 무명 감은 팔로 장작개비를 든다. 지난번 그 팔이다.
상복 셋이 물러나지 않는다. 지난번에 물러난 걸 기억하는 자들이다.
맨 앞의 칼이 당신 대신 앞에 선 노인의 가슴에 들어간다. 소리가 작다.
하진무가 주저앉는다. 장작개비가 굴러간다. 노인이 당신 소매를 잡는다.
"……셈이…… 이제 맞소. 장문인께…… 진 빚, 객한테…… 다 갚았으니."
상복들이 물러난다. 저희도 이걸 바란 건 아니었다는 얼굴로. 마당에 노인 하나가 남는다. 주판알 몇 개가 피 웅덩이로 굴러간다.
@set f_hajindead=1
@set g_hajindied=1
@fx curse:5 sl:1
@set grudgeday=day+random(4,7) if:grudge<1
@set grudge=grudge+1
@goto #NightEnd
# KGrAlly
담 위의 사내가 뛰어내린다. 비무판에서 살려 보낸 그 사내다.
"이 사람 목숨에는 내 목숨이 걸려 있소. 셈을 하려거든 나부터 하시오."
상복들이 서로를 본다. 두 사람을 상대로 셈을 할 만큼 급한 원한은 아니었던 모양이다. 마당이 빈다.
@set f_sparedally=0
@goto #NightEnd

; --- 밤: 며칠 밤의 선택 ---
# Night
@art char:none
@scene id:night
@goto #NvOld if:curse>=80&&curse<88&&f_oldseen>0&&tn_oldvoice<1
@pickflavor pool:night
@goto #Nv2 if:nrand==2
@goto #Nv3 if:nrand==3
@goto #Nv4 if:nrand==4
@goto #Nv5 if:nrand==5
@goto #Nv6 if:nrand==6
@goto #Nv7 if:nrand==7
@goto #Nv8 if:nrand==8
@goto #Nv9 if:nrand==9
@goto #Nv10 if:nrand==10
@goto #Nv11 if:nrand==11
@goto #Nv12 if:nrand==12
@goto #Nv13 if:nrand==13
@goto #Nv14 if:nrand==14
@goto #Nv1
# Nv1
해가 저문다. 며칠 밤이 온전히 당신의 것이다.
@goto #NightChoice
# NvOld
@set tn_oldvoice=1
해가 저문다. 마당이 조용하다. 바람조차 멎었다.
'거의 다 익었다.'
뼛속의 못이 운다. 노인의 목소리다. 그는 어디에도 없다. 있을 필요도 없다. 당신 안에 있으니.
'서두르지 마라. 익는 것은 네가 아니라 열매니라.'
소리가 돌아온다. 술꾼들의 노래, 주판 소리. 며칠 밤이 남았다. 전보다 한결 짧은 밤들이.
@fx curse:1
@goto #NightChoice
# Nv2
등불이 하나둘 켜진다. 셈이 끝났다. 이제 며칠 밤은 당신의 것이다.
@goto #NightChoice
# Nv3
객잔의 소음이 잦아든다. 몸은 고단하고, 가슴의 문양은 조용히 제 할 일을 한다.
@goto #NightChoice
# Nv4
창밖에 달이 올랐다. 그날 밤의 달보다 희다. 남은 며칠 밤을 손에 쥔다.
@goto #NightChoice
# Nv5
아래층에서 술꾼들의 노랫소리가 올라온다. 며칠 밤이 남았다.
@goto #NightChoice
# Nv6
점소이가 등잔 기름을 채워 간다. "객관님, 오늘도 늦게 주무십니까요." 늦는다. 매일 늦는다.
@goto #NightChoice
# Nv7
밤바람에 문풍지가 운다. 가슴의 문양도 같은 박자로 운다.
@goto #NightChoice
# Nv8
하진무가 셈을 마치고 주판을 덮는다. 당신의 밤은 며칠 더 남았다.
@goto #NightChoice
# Nv9
골목 어귀에 등불 하나가 오래 서 있다. 누군가 객잔을 지켜보는 밤이다.
@goto #NightChoice
# Nv10
밤이 길어졌다. 계절 탓인지, 당신 탓인지. 밤들이 전보다 무겁다.
@goto #NightChoice
# Nv11
달이 붉다. 그날 밤과 같은 빛이다. 창을 등지고 앉는다.
@goto #NightChoice
# Nv12
밤이면 문양이 뜨겁다. 손바닥을 얹으면 심장이 둘인 것 같다.
@goto #NightChoice
# Nv13
객잔 아래층이 조용하다. 손님이 줄었다. 당신 때문이라는 말을 하진무는 하지 않는다.
@goto #NightChoice
# Nv14
밤마다 가슴의 글자를 센다. 오늘도 하나 늘었다. 늘어난 만큼 검을 쥔다.
@goto #NightChoice
# NightChoice
@choice "마당에서 검을 수련한다 — 검술이 오른다" goto:#NSw
@choice "앉아서 기를 돌린다(운기조식) — 내공이 오르고 사술이 가라앉는다" goto:#NQi
@choice "저자로 나간다 — 품을 팔아 은자를 벌거나 물건을 산다" goto:#NightTown
@choice "비무판을 찾아간다 — 이기면 서열이 오른다" if:day>=4&&f_ringclosed<1 goto:#NDuel
@choice "뒷골목 비무판 — 판돈 셋, 보는 눈 없음" if:f_ringclosed>0 goto:#NDuelBack
@choice "혈쇄문의 초대에 응한다" if:f_wolfinvite>0&&f_wolfdown<1 goto:#NWolf
@choice "소아와 떠난다 — 강호를 등진다" if:f_soabond>0&&f_soadead<1&&day>=38&&b_leave<1 goto:#NLeave
@choice "금창약을 덜어 덧난 상처를 다시 싸맨다" if:taint>0&&taintkind==2&&f_salve>0 goto:#NSalve
@choice "몸을 쉰다 — 체력을 되찾는다" goto:#NRest
@stop
# NSalve
무명을 풀자 고름 냄새가 방에 찬다. 백초당 금창약을 상처에 꾹꾹 눌러 채운다. 이를 악문다.
새벽녘, 열이 내린다. 통은 비었다.
@set taint=0
@set f_salve=0
@fx hp:1
@goto #NightEnd
# NSw
@set nmul=3
@set tr=random(1,100)
@goto #NSwT1 if:tn_sw1<1&&day>=4&&tr<=30
@goto #NSwT2 if:tn_sw2<1&&day>=9&&tr<=30
@goto #NSwB if:f_bilokhalf>0||f_biloklearn>0
@set tr=random(1,100)
@goto #NSwX1 if:tr<=10&&f_soamet>0&&f_soadead<1
@goto #NSwX2 if:tr<=17
@set sv=random(1,4)
@goto #NSw2 if:sv==2
@goto #NSw3 if:sv==3
@goto #NSw4 if:sv==4
달빛 아래 횡소(橫掃)를 천 번 긋는다. 손바닥이 터지고, 손끝에 감각이 쌓인다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSw2
횡소 천 번, 자세는 하나. 사형이 세던 숫자를 이제 당신이 센다. 팔백에서 어깨가 울고, 구백에서 잠잠해진다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSw3
마당의 느티나무를 상대로 천 번. 나무는 피하지 않는다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSw4
달 없는 밤. 보이지 않는 검끝을 손끝으로 더듬는다. 천 번째에는 눈 없이도 검이 어디 있는지 안다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSwX1
삼백 번째쯤에서 담 위에 그림자가 앉는다. 소아다. 말없이 본다. 오백 번째에 입을 연다.
"왼손이 반 박자 늦다. 사형이 그렇게 가르쳤나."
"……사형은 그게 내 버릇이라 했다."
"버릇은 죽을 자리를 알려 준다. 고쳐라." 그러고는 담 너머로 사라진다.
@fx sw:2 hp:-1
@set aff=aff+1
@goto #NightEnd
# NSwX2
칠백 번째. 쨍 소리와 함께 손이 가벼워진다. 날 끝이 이가 빠졌다. 녹을 벗긴 지 얼마 안 된 날이다.
대장간에 맡기면 이틀, 은자 둘.
@fx mn:-2 hp:-1
@goto #NightEnd
# NSwT1
@set tn_sw1=1
@gosub MolakEvents#T_Sw1
@goto #NightEnd
# NSwT2
@set tn_sw2=1
@gosub MolakEvents#T_Sw2
@goto #NightEnd
# NSwB
@set sv=random(1,3)
@goto #NSwB2 if:sv==2
@goto #NSwB3 if:sv==3
「운검비록」의 구결이 손끝을 이끈다. 어제 반 치, 오늘 반 치가 쌓인다.
@fx sw:2 hp:-1
@goto #NightEnd
# NSwB2
비록의 구결이 몸에 든다. 손목이 아니라 허리, 허리가 아니라 발. 어제 몰랐던 반 치가 오늘 손에 있다.
@fx sw:2 hp:-1
@goto #NightEnd
# NSwB3
운검비록 제삼결. 획 하나를 천 번 긋는다. 종이가 아니라 허공에. 허공이 베이는 소리가 이제 들린다.
@fx sw:2 hp:-1
@goto #NightEnd
# NQi
@set nmul=3
@set tr=random(1,100)
@goto #NQiT1 if:tn_qi1<1&&day>=5&&tr<=30
@goto #NQiT2 if:tn_qi2<1&&day>=12&&curse>=25&&tr<=30
@goto #NQiB if:f_breath>0
@set tr=random(1,100)
@goto #NQiX1 if:tr<=8&&curse>=30
@goto #NQiX2 if:tr<=15
@set sv=random(1,4)
@goto #NQi2 if:sv==2
@goto #NQi3 if:sv==3
@goto #NQi4 if:sv==4
조식(調息), 취기(聚氣), 운기(運氣)… 토탁(吐濁)에서 막힌다. 뱉어야 할 탁기를, 가슴의 <color=#9A70C4>문양이 먼저 삼킨다</color>.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQi2
운기 한 바퀴. 단전에서 올라온 기가 가슴에서 한 번 멈춘다. 문양이 통행세를 거두는 자리다. 내고 지나간다.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQi3
들숨, 날숨. 벽 너머 술꾼들의 노래가 박자가 된다. 문양은 제 몫을 챙긴다.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQi4
운기 도중 사형의 목소리가 들린 것 같다. '막내야, 숨이 급하다.' 숨을 늦춘다. 기가 한 뼘 깊이 내려가고, 문양도 한 뼘 따라온다.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQiX1
운기 셋째 바퀴. 기가 가슴에서 멈추지 않고 거꾸로 돈다. 문양 쪽으로 빨려 든다. 입 안에 쇳내가 고인다.
주화입마(走火入魔)의 문턱이다. 억지로 숨을 끊는다. 피를 한 모금 뱉는다.
@fx hp:-2 curse:5
@goto #NightEnd
# NQiX2
운기 도중 숨 하나가 길어진다. 아주 길게. 단전 밑바닥에 무언가 닿는다. 문양이 따라오지 못한 깊이다.
눈을 뜨니 새벽이다. 밤 하나가 숨 한 번이었다.
@fx ng:3 curse:-1
@goto #NightEnd
# NQiT1
@set tn_qi1=1
@gosub MolakEvents#T_Qi1
@goto #NightEnd
# NQiT2
@set tn_qi2=1
@gosub MolakEvents#T_Qi2
@goto #NightEnd
# NQiB
@goto #NQiB3 if:f_breath2>0
@set sv=random(1,2)
@goto #NQiB2 if:sv==2
들숨 여섯, 날숨 아홉. 거지 중의 구결대로 숨을 바꾸자, 탁기가 덜 쌓인다.
@fx ng:2 hp:1 curse:2
@goto #NightEnd
# NQiB2
여섯, 아홉. 구결대로 숨을 바꾼다. 문양이 삼키는 몫이 손톱만큼 준다.
@fx ng:2 hp:1 curse:2
@goto #NightEnd
# NQiB3
여섯, 아홉, 그리고 반 호흡 멈춤. 거지 중의 두 번째 구결이다. 탁기가 씨앗에 닿기 전에 입으로 빠져나간다. 문양이 굶는다.
@fx ng:2 hp:1 curse:1
@goto #NightEnd
# NightTown
저녁 저자. 등불이 하나둘 켜진다.
@choice "날품을 판다 — 물지게와 장작" goto:#NWork
@choice "상점가를 둘러본다" goto:#Town1
@choice "전당포 뒷방 — 고리대 왕삼에게 은자를 빌린다" if:debt<1&&mn<8 goto:#NLoan
@choice "왕삼의 장부를 훔치러 전당포 뒷방에 든다" if:debt>0&&g_know_wangsam>0 goto:#NLedger
@choice "객잔으로 돌아간다" goto:#NightEnd
@stop
# NLoan
@art scene:pawn
전당포 뒷방. 기름 먹은 등잔 아래 배가 나온 사내가 장부를 넘긴다. 고리대 왕삼이다.
"열닷 냥. 이레 뒤에 스물닷 냥. 못 갚으면 갚을 만한 것으로 받소. 손가락이든, 객잔 늙은이 셈판이든."
@goto #NLoanC if:g_end_chae<1
<color=#9A70C4>저 장부의 붓끝이 지난 생, 피 묻은 손가락으로 이름 위에 줄을 그었다.</color>
# NLoanC
@choice "빌린다 — 은자 15, 이레 뒤 25" goto:#NLoanY
@choice "\"됐소.\" — 일어선다" goto:#NightEnd
@stop
# NLedger
@art scene:pawn
<color=#9A70C4>지난 생, 저 장부가 어느 궤짝 셋째 칸에 드는지 보았다.</color> 피 묻은 손가락으로 이름에 줄을 긋던 그 장부다.
한밤중. 전당포 뒷담은 낮다. 기름 먹은 등잔이 꺼져 있다.
@set tr=random(1,100)
@goto #NLedgerOk if:tr<=55+sl*3
궤짝 뚜껑을 여는 순간 뒤에서 등잔이 켜진다. 왕삼이 잠옷 바람으로 서 있다. 뒤에 수하 둘.
"장부를 훔치는 손님은 처음이 아니오. 그 손님들 손가락이 지금 어디 있는지 아시오?"
@set debtday=day
@goto #NightEnd
# NLedgerOk
궤짝 셋째 칸. 쥐 꼬리 같은 글씨의 장부가 거기 있다. 당신 이름이 적힌 장을 찢는다. 그 앞뒤 장에 적힌 이름들도 같이 찢는다. 저잣거리 사람들 이름이다.
아궁이에 넣는다. 종이가 오그라들며 이름들이 하나씩 탄다.
이튿날 저잣거리 몇 집의 아침이 조금 늦게 시작된다. 아무도 이유를 묻지 않는다.
@set debt=0
@set debtext=0
@set f_wangsam=1
@fx sl:1
@goto #NightEnd
# NLoanY
왕삼이 은자를 세어 밀어 준다. 장부에 이름이 적힌다. 붓끝이 이름 위에서 한 번 멈춘다.
"청운 쪽 이름이로군. 잘 갚으시오. 그쪽 이름은 값이 잘 나가니."
@fx mn:15
@set debt=25
@set debtday=day+7
@set debtext=0
@goto #NightEnd
# NWork
@set nmul=3
@set tr=random(1,100)
@goto #NWorkT1 if:tn_wk1<1&&day>=6&&tr<=30
@set r=random(3,4)
@set tr=random(1,100)
@goto #NWorkX1 if:tr<=10
@goto #NWorkX2 if:tr<=19&&f_taxknow<1&&day>=14
@goto #NWorkX3 if:tr<=26
@set sv=random(1,3)
@goto #NWork2 if:sv==2
@goto #NWork3 if:sv==3
물지게 마흔 번. 어깨에 밧줄 자국이 팬다. 삯은 정직하다.
@fx mn:{r} hp:-1
@goto #NightEnd
# NWork2
장작 이백 개를 팬다. 도끼질에도 검법이 있다고 여기면 덜 지겹다. 어깨가 쑤신다.
@fx mn:{r} hp:-1
@goto #NightEnd
# NWork3
저자 창고에서 가마니를 나른다. 창고지기가 손바닥의 굳은살을 보더니 품삯에 반 닢을 얹어 준다.
@fx mn:{r} hp:-1
@goto #NightEnd
# NWorkX1
물지게 마흔 번. 삯을 받으러 가니 십장이 바뀌어 있다. 새 십장은 어제 일은 모른다고 한다. 뒤에 선 왈패 둘이 웃는다.
@fx hp:-1
@set tr=random(1,100)
@goto #NightEnd if:sl<4
십장의 장부를 손등으로 덮는다. 왈패 둘이 웃음을 거둔다. 삯이 나온다. 이자까지.
@fx mn:{r} sl:1
@goto #NightEnd
# NWorkX2
창고에서 가마니를 나른다. 창고지기가 장부를 덮으며 혼잣말을 한다.
"징세조는 해가 중천에 오르기 전에 온다네. 붉은 끈 다섯. 우두머리는 칼을 뽑을 때 왼 무릎부터 굽히지. 삼십 년 창고지기 하면 그런 것만 보여."
@fx mn:{r} hp:-1
@set f_taxknow=1
@goto #NightEnd
# NWorkX3
가마니 더미가 무너진다. 아래 있던 아이를 밀쳐 내고 대신 어깨로 받는다. 뼈는 무사하다. 어깨가 며칠은 안 올라가겠다.
아이 어미가 삯 대신 떡 한 보자기를 쥐여 준다.
@fx hp:-2
@set injury=injury+2
@goto #NightEnd
# NWorkT1
@set tn_wk1=1
@gosub MolakEvents#T_Wk1
@goto #NightEnd
# NDuel
저잣거리 공터의 비무판. 서열을 건 칼들이 밤마다 부딪치는 곳이다.
@set dmore=0
# NDuelAgain
@set dkind="any"
@gosub MolakDuel#Run
@set dmore=dmore+1
@goto #NightEnd if:duelwin<1||dmore>=3||hp<hpmax/2
남은 밤이 있다. 판 가장자리에서 다음 칼이 손짓한다.
@choice "한 판 더 — 남은 밤도 비무판에서" goto:#NDuelAgain
@choice "오늘은 여기까지" goto:#NightEnd
@stop
# NDuelBack
폐가 뒷마당. 횃불 둘. 심판도 방(榜)도 없다. 이기면 판돈이고, 지면 아무도 묻지 않는다.
@set dkind="back"
@gosub MolakDuel#Run
@goto #NightEnd
# NWolf
@goto Molak04#Wf1
# NLeave
@set b_leave=1
@goto Molak06#Leave1
# NRest
@set nmul=3
@set tr=random(1,100)
@goto #NRestT1 if:tn_rest1<1&&day>=5&&tr<=30
@set tr=random(1,100)
@goto #NRestX1 if:tr<=10&&g_runs>0
@goto #NRestX2 if:tr<=18&&f_hajindead<1
@set sv=random(1,4)
@goto #NRest2 if:sv==2
@goto #NRest3 if:sv==3
@goto #NRest4 if:sv==4
침상에 눕는다. 아무 일도 없는 밤. 지금의 당신에게는 사치다.
@fx hp:3
@goto #NightEnd
# NRest2
일찍 눕는다. 일 년 동안 세던 천장의 얼룩을 센다. 오늘은 하나 늘어 보인다. 착각일 것이다.
@fx hp:3
@goto #NightEnd
# NRest3
잠이 오지 않아 창을 연다. 달이 마당의 느티나무에 걸려 있다. 아무 일도 없는 밤이다.
@fx hp:3
@goto #NightEnd
# NRest4
점소이가 두고 간 식은 국밥을 마저 먹고 눕는다. 배부른 것도 수련이라고 사형이 말했었다. 믿기로 한다.
@fx hp:3
@goto #NightEnd
# NRestX1
꿈에서 죽는다. 지난 생의 그 자리, 그 칼, 그 냄새. 깨어 보니 이불이 땀에 젖었다.
몸은 쉬었는데 마음은 한 번 더 죽었다. 대신 그 칼이 오던 각도가 조금 더 또렷하다.
@fx hp:2 curse:1 sw:1
@goto #NightEnd
# NRestX2
문 두드리는 소리. 하진무가 국밥 한 그릇을 들고 서 있다. "남았소. 버리기 아까워서." 김이 아직 오른다. 남은 국밥이 아니다.
@fx hp:5
@goto #NightEnd
# NRestT1
@set tn_rest1=1
@gosub MolakEvents#T_Rest1
@goto #NightEnd

# NightEnd
@set nmul=0
@daytick n:3
@goto MolakOver#Taint if:taint>=6
@goto MolakOver#Taint if:taint>0&&hp<=0
@goto #Collapse if:hp<=0&&collapsed<1||hp<=0&&collapsed<2&&f_hajinbond>0&&f_hajindead<1
@goto MolakOver#Starve if:hp<=0&&starved>0
@goto MolakOver#Exhaust if:hp<=0
@goto MolakOver#Curse if:curse>=100
@goto #D10 if:day>=10&&ms_d10<1
@goto #D18 if:day>=18&&ms_d18<1
@goto #D25 if:day>=25&&ms_d25<1
@goto #D35 if:day>=35&&ms_d35<1
@goto #D50 if:day>=50&&ms_d50<1
@goto #Evening
# D10
@set ms_d10=1
아무것도 하지 않은 날에도 가슴의 문양이 <color=#9A70C4>조금 자라 있다</color>. 사술이 뿌리를 내렸다. 이제 시간은 당신 편이 아니다.
@goto #Evening
# D18
@set ms_d18=1
가슴의 문양이 <color=#9A70C4>익어간다</color>. 자라는 속도가 눈에 띄게 빨라졌다. 노인의 말이 떠오른다. '다 익으면'… 그 뒤는 듣지 못했다.
@goto #Evening
# D25
@set ms_d25=1
하진무가 방값 패를 바꿔 단다. "교의 징세가 또 올랐소, 객. 이제부터 하룻밤 두 냥이오."
@goto #Evening
# D35
@set ms_d35=1
한밤중, 가슴이 타는 듯해 눈을 뜬다. 문양이 <color=#9A70C4>스스로 꿈틀거리고 있다</color>. 뿌리가 깊어졌다. 이제부터는 하루가 다르게 자랄 것이다.
@goto #Evening
# D50
@set ms_d50=1
문양이 가슴을 넘어 <color=#C03434>쇄골까지 뻗었다</color>. 백초 할멈이 맥을 짚더니 처음으로 말을 아낀다. 남은 날이 많지 않다.
@goto #Evening
# Evening
@art char:none
@pickevent chance:55 slot:night
@gosub #RunEvent if:nextevent!="none"
@goto #DayLoop

# RunEvent
@gosub MolakEvents#E_Yong if:nextevent=="E_Yong"
@gosub MolakEvents#E_Spared if:nextevent=="E_Spared"
@gosub MolakEvents#E_JinSister if:nextevent=="E_JinSister"
@gosub MolakEvents#E_HajinNight if:nextevent=="E_HajinNight"
@gosub MolakEvents#E_Cup if:nextevent=="E_Cup"
@gosub MolakEvents#E_Hostage if:nextevent=="E_Hostage"
@gosub MolakEvents#E_Flood if:nextevent=="E_Flood"
@gosub MolakEvents#E_Maeng1 if:nextevent=="E_Maeng1"
@gosub MolakEvents#E_Maeng2 if:nextevent=="E_Maeng2"
@gosub MolakEvents#E_Maeng3 if:nextevent=="E_Maeng3"
@gosub MolakEvents#E_Namgung if:nextevent=="E_Namgung"
@gosub MolakEvents#E_Gaebang1 if:nextevent=="E_Gaebang1"
@gosub MolakEvents#E_Gaebang2 if:nextevent=="E_Gaebang2"
@gosub MolakEvents#E_Hao if:nextevent=="E_Hao"
@gosub MolakEvents#E_JangSell if:nextevent=="E_JangSell"
@gosub MolakEvents#E_JangTaken if:nextevent=="E_JangTaken"
@gosub MolakEvents#E_YongSell if:nextevent=="E_YongSell"
@gosub MolakEvents#E_HerbNight if:nextevent=="E_HerbNight"
