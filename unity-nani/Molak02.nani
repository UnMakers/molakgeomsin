; ===== 몰락검신 — 조운현의 나날 (하루 루프) =====
# DayLoop
@goto MolakOver#Curse if:curse>=100
@goto MolakOver#Exhaust if:hp<=0
; --- 장(章)·비트 ---
@goto Molak04#Ld0 if:f_wolfdown>0&&rank>0&&rank<=10
@goto #ChWolf if:rank>0&&rank<=100&&f_wolfdown<1&&f_wolfinvite<1
@goto #ChSoa if:day>=3&&f_soamet<1&&b_soa<1
@goto #B5 if:day>=5&&b_hajin<1
@goto #B8 if:day>=8&&b_wanted<1
@goto #B11 if:day>=11&&b_jang<1
@goto #B13 if:day>=13&&f_soamet>0&&b_soatrain<1
@goto #ChUnju if:day>=15&&f_unjudone<1
@goto #B20 if:day>=20&&rank>0&&rank<=500000&&b_fame<1
@goto #ChShr if:day>=22&&f_shrseen<1
@goto #ChBilok if:day>=24&&f_bilok>0&&b_bilok<1
@goto #ChHm if:day>=26&&b_hm<1
@goto #ChAmhyang if:day>=30&&b_amhyang<1
@goto #B32 if:day>=32&&rank>0&&rank<=1000&&b_depart<1
@goto #ChOld if:day>=36&&b_old<1
@goto #A12 if:day>=12&&f_yongspared>0&&b_yong2<1
@goto #A17 if:day>=17&&b_hajin2x<1
@goto #A19 if:day>=19&&b_jang2<1
@goto #A21 if:day>=21&&f_soamet>0&&f_shrinedone>0&&b_soa3<1
@goto #A23 if:day>=23&&b_herb2<1
@goto #A24 if:day>=24&&rank>0&&rank<=2000&&f_wolfdown<1&&f_wolfedge<1&&b_chain<1
@goto #A27 if:day>=27&&seen_E_Rival>0&&b_rival2<1
@goto #A28 if:day>=28&&f_soamet>0&&b_soa4<1
@goto #A33 if:day>=33&&f_amhyangknown>0&&b_amh2<1
@goto #A34 if:day>=34&&f_hmsaved>0&&f_ochisaved<1&&b_ochi<1
@goto #A40 if:day>=40&&f_oldseen>0&&b_old2x<1
@set dice=random(1,100)
@goto #BS1 if:day>=5&&f_soamet>0&&b_s1<1&&dice<=55
@goto #BR1 if:day>=6&&b_r1x<1&&dice>=35
@goto #BS2 if:day>=9&&f_soamet>0&&b_s2<1&&dice<=60
@goto #BR2 if:day>=12&&f_janginfo>0&&b_r2x<1&&dice>=30
@goto #BS3 if:day>=18&&f_soamet>0&&aff>=2&&b_s3<1&&dice<=60
@goto #BR3 if:day>=19&&b_r2x>0&&b_r3x<1&&dice>=35
@goto #BS4 if:day>=24&&f_soamet>0&&b_s4<1&&dice<=65
@goto #BR4 if:day>=27&&b_r3x>0&&b_r4x<1&&dice>=30
@goto #BS5 if:day>=30&&aff>=4&&f_soasaved>0&&b_s5<1
@goto #BR5 if:day>=34&&b_r4x>0&&b_r5x<1
@goto #BS1 if:day>=9&&f_soamet>0&&b_s1<1
@goto #BR1 if:day>=10&&b_r1x<1
@goto #BR2 if:day>=17&&f_janginfo>0&&b_r2x<1
@goto #BR3 if:day>=24&&b_r2x>0&&b_r3x<1
@goto #BR4 if:day>=32&&b_r3x>0&&b_r4x<1
@goto #BH1 if:day>=45&&f_wolfdown<1&&b_hunt1<1
@goto #BH2 if:day>=50&&f_wolfdown<1&&b_hunt2<1
@goto #BH3 if:day>=55&&f_wolfdown<1&&b_hunt3x<1
; --- 아침 풍경 ---
@scene id:day
@vfx kind:rainoff
@pickflavor pool:morning
@goto #M2 if:mrand==2
@goto #M3 if:mrand==3
@goto #M4 if:mrand==4
@goto #M5 if:mrand==5
@goto #M6 if:mrand==6
@goto #M7 if:mrand==7
@goto #M8 if:mrand==8
@goto #M9 if:mrand==9
@goto #M10 if:mrand==10
@goto #M11 if:mrand==11
@goto #M12 if:mrand==12
@goto #M13 if:mrand==13
@goto #M14 if:mrand==14
@goto #M15 if:mrand==15
@goto #M16 if:mrand==16
@goto #M17 if:mrand==17
@goto #M18 if:mrand==18
@goto #M19 if:mrand==19
@goto #M20 if:mrand==20
@goto #M21 if:mrand==21
@goto #M22 if:mrand==22
@goto #M23 if:mrand==23
@goto #M24 if:mrand==24
@goto #M25 if:mrand==25
@goto #M26 if:mrand==26
@goto #M27 if:mrand==27
@goto #M28 if:mrand==28
@goto #M1
# M1
운락객잔의 아침. 장작 냄새와 어제 비 냄새가 마당에 남아 있다.
@goto #Daytime
# M2
국밥 끓는 냄새에 눈을 뜬다. 허기가—당신이 살아 있다는 증거처럼 군다.
@goto #Daytime
# M3
하진무가 주판알을 튕기다 말고, 당신의 안색부터 살핀다. 일 년을 간호한 사람의 버릇이다.
@goto #Daytime
# M4
멀리 북쪽 하늘이 유난히 검다. 혈마곡이 있는 방향이다.
@goto #Daytime
# M5
우물가의 아낙들이 목소리를 낮춘다. 또 누가 서열전에서 죽었다는 이야기일 것이다.
@goto #Daytime
# M6
점소이가 마당을 쓸다 말고 당신에게 꾸벅, 고개를 숙인다. 어제보다 깊이. 소문이 도는 모양이다.
@goto #Daytime
# M7
밤새 비가 다녀갔다. 처마 끝에서 떨어지는 물방울이 셈을 세듯 고르다.
@goto #Daytime
# M8
관도 쪽에서 말발굽 소리. 붉은 끈의 전령이 북쪽으로 달려간다. 교의 소식은 늘 사람보다 빠르다.
@goto #Daytime
# M9
창호지에 빛이 번진다. 일 년을 누워 보던 그 천장이 오늘은 조금 낮아 보인다. 몸이 자란 것이 아니라—마음이 일어선 것이다.
@goto #Daytime
# M10
마당에서 점소이가 닭 모가지를 비튼다. 국밥집의 아침은 늘 작은 죽음으로 시작한다. 당신은 그것을 끝까지 본다.
@goto #Daytime
# M11
객잔 앞 느티나무에 까치가 운다. 좋은 소식이 올 거라고 점소이가 말하지만—이 현에서 좋은 소식은 대개 남의 것이다.
@goto #Daytime
# M12
아침 저자로 나가는 장사치들의 행렬. 그 틈에 붉은 끈 하나가 섞여 걷는다. 세는 사람이, 세어지고 있다.
@goto #Daytime
# M13
가슴의 문양이 아침 햇빛 아래서는 희미하다. 낮에는 잠든 척하는 것이다. 밤이 되면 다시 제 할 일을 할 것이다.
@goto #Daytime
# M14
거울 대신 세숫물에 얼굴을 비춘다. 일 년 전의 얼굴은 거기 없다. 수배서의 그림이 틀린 것이 아니라—당신이 바뀐 것이다.
@goto #Daytime
# M15
아침부터 객잔 앞을 서성이는 낯선 그림자. 하진무가 빗자루로 마당을 쓸며 슬쩍 그자를 밀어낸다. 빗자루질에도 솜씨가 있다.
@goto #Daytime
# M16
시장통 개 짖는 소리가 평소보다 사납다. 밤새 누가 지나갔다는 뜻이다. 사람인지, 사람이 아닌 것인지는 모른다.
@goto #Daytime
# M17
아침 안개가 짙다. 열 걸음 앞이 보이지 않는 날—검을 쥔 손이 먼저 깨어 있다.
@goto #Daytime
# M18
마당의 담 위에 쌍검 자국 같은 흠집이 새로 나 있다. 소아가 다녀갔거나—그녀를 흉내 내는 바람이 지나갔거나.
@goto #Daytime
# M19
점소이가 조심스럽게 묻는다. "객, 북쪽에 정말 가실 겁니까." 대답 대신 국밥을 비운다. 그릇 바닥이 답이다.
@goto #Daytime
# M20
아침부터 가슴이 미지근하다. 문양이 자라는 날은 몸이 먼저 안다. 당신은 그 미지근함을 세어 두는 버릇이 생겼다.
@goto #Daytime
# M21
낯선 무인 하나가 마당 건너편에서 당신의 서열 패를 흘끔거린다. 올라갈수록 등 뒤의 눈이 늘어난다. 그것이 서열의 값이다.
@goto #Daytime
# M22
하진무가 방값 장부를 넘기다 당신 이름 칸에서 손을 멈춘다. 셈이 틀려서가 아니다. 날짜가—너무 많이 쌓여서다.
@goto #Daytime
# M23
아침 바람이 차다. 계절이 바뀌고 있다. 당신에게 남은 계절이 몇 개나 되는지—세어보지 않기로 한다.
@goto #Daytime
# M24
가슴의 문양이 쇄골 쪽으로 손가락 한 마디쯤 기어올랐다. 옷깃을 여민다. 숨기는 것이 아니라—보지 않으려는 것이다.
@goto #Daytime
# M25
마당의 느티나무 잎이 절반쯤 졌다. 떨어진 잎을 세듯 남은 날을 센다. 세는 것을 그만둔 날이 진짜 끝일 것이다.
@goto #Daytime
# M26
새벽에 누가 창에 돌을 던졌다. 창호지에 구멍 하나. 내다보니 아무도 없다. 교의 인사인지, 다른 누구의 것인지.
@goto #Daytime
# M27
눈을 뜨자 손이 검자루를 쥐고 있다. 잠결에 쥔 것이다. 몸이 먼저 전쟁을 시작했다.
@goto #Daytime
# M28
하진무가 국밥에 고기를 한 점 더 얹는다. 말은 없다. 셈 밝은 영감이 셈을 틀리는 날은—무슨 뜻인지, 서로 안다.
@goto #Daytime

# Daytime
@pickevent chance:65 slot:day
@gosub #RunEvent if:nextevent!="none"
@goto #Night

# AfterChapter
@art char:none
@goto #Night

; --- 밤: 반시진의 선택 ---
# Night
@art char:none
@scene id:night
@pickflavor pool:night
@goto #Nv2 if:nrand==2
@goto #Nv3 if:nrand==3
@goto #Nv4 if:nrand==4
@goto #Nv5 if:nrand==5
@goto #Nv6 if:nrand==6
@goto #Nv7 if:nrand==7
@goto #Nv8 if:nrand==8
@goto #Nv9 if:nrand==9
@goto #Nv10 if:nrand==10
@goto #Nv11 if:nrand==11
@goto #Nv12 if:nrand==12
@goto #Nv13 if:nrand==13
@goto #Nv14 if:nrand==14
@goto #Nv1
# Nv1
해가 저문다. 온전히 당신의 것인 반시진이 남았다.
@goto #NightChoice
# Nv2
등불이 하나둘 켜진다. 하루의 셈이 끝나고—이제 당신의 반시진이다.
@goto #NightChoice
# Nv3
객잔의 소음이 잦아든다. 몸은 피곤을 말하고, 가슴의 문양은 조용히 저 할 일을 한다. 반시진—어디에 쓸 것인가.
@goto #NightChoice
# Nv4
창밖에 달이 올랐다. 그날 밤의 달보다 희다. 남은 반시진을 손에 쥔다.
@goto #NightChoice
# Nv5
아래층에서 술꾼들의 노랫소리. 강호의 밤은 늘 누군가의 잔치고 누군가의 초상이다. 당신의 반시진이 남았다.
@goto #NightChoice
# Nv6
점소이가 등잔 기름을 채워 간다. "객, 오늘도 늦으십니까." 늦는다. 매일 늦는다. 반시진은 그러라고 있는 것이다.
@goto #NightChoice
# Nv7
밤바람에 문풍지가 운다. 가슴의 문양도 같은 박자로 운다. 둘 다 못 들은 척하고—반시진을 어디에 쓸지 정한다.
@goto #NightChoice
# Nv8
하진무가 셈을 끝내고 주판을 덮는 소리. 하루가 닫히는 소리다. 당신의 하루는 아직 반시진 남았다.
@goto #NightChoice
# Nv9
골목 어귀에 등불 하나가 오래 서 있다. 누군가 객잔을 지켜보는 밤. 그래도 반시진은 당신의 것이다.
@goto #NightChoice
# Nv10
밤이 길어졌다. 계절 탓인지, 당신 탓인지. 반시진이 전보다 무겁다.
@goto #NightChoice
# Nv11
달이 붉다. 그날 밤과 같은 색. 당신은 창을 등지고 앉는다. 반시진—등 뒤의 달은 잊기로 한다.
@goto #NightChoice
# Nv12
문양이 밤이면 뜨겁다. 손바닥을 얹으면 심장이 둘인 것 같다. 둘 중 하나의 것인 반시진을, 당신 것으로 쓴다.
@goto #NightChoice
# Nv13
객잔 아래층이 조용하다. 손님이 줄었다. 당신 때문이라는 걸 하진무는 말하지 않는다. 반시진이 남았다.
@goto #NightChoice
# Nv14
밤마다 가슴의 글자를 센다. 오늘도 하나 늘었다. 늘어난 만큼 검을 쥔다. 반시진.
@goto #NightChoice
# NightChoice
@choice "마당에서 검을 간다" goto:#NSw
@choice "가부좌를 틀고 운기조식한다" goto:#NQi
@choice "저자로 나간다 — 날품과 가게들" goto:#NightTown
@choice "비무판을 찾아간다" if:day>=4 goto:#NDuel
@choice "혈쇄문의 초대에 응한다" if:f_wolfinvite>0&&f_wolfdown<1 goto:#NWolf
@choice "몸을 쉰다" goto:#NRest
@stop
# NSw
@set tr=random(1,100)
@goto #NSwT1 if:tn_sw1<1&&day>=4&&tr<=30
@goto #NSwT2 if:tn_sw2<1&&day>=9&&tr<=30
@goto #NSwB if:f_bilokhalf>0||f_biloklearn>0
@set sv=random(1,4)
@goto #NSw2 if:sv==2
@goto #NSw3 if:sv==3
@goto #NSw4 if:sv==4
달빛 아래 천 번의 횡소(橫掃). 손바닥이 터지고, 감각이 쌓인다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSw2
횡소 천 번, 자세는 하나. 사형이 세던 숫자를 당신이 센다. 팔백에서 어깨가 울고, 구백에서 조용해진다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSw3
마당의 느티나무를 상대로 천 번. 나무는 피하지 않는다. 피하지 않는 상대를 베는 연습은—결국 제 검을 보는 연습이다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSw4
달이 없는 밤. 보이지 않는 검끝을 손끝으로 더듬는다. 천 번째에—검이 어디 있는지 눈 없이 안다.
@fx sw:1 hp:-1
@goto #NightEnd
# NSwT1
@set tn_sw1=1
@gosub MolakEvents#T_Sw1
@goto #NightEnd
# NSwT2
@set tn_sw2=1
@gosub MolakEvents#T_Sw2
@goto #NightEnd
# NSwB
@set sv=random(1,3)
@goto #NSwB2 if:sv==2
@goto #NSwB3 if:sv==3
「운검비록」의 구결이 손끝을 이끈다. 어제의 반 치, 오늘의 반 치—그것이 쌓여 벽이 된다.
@fx sw:2 hp:-1
@goto #NightEnd
# NSwB2
비록의 구결이 몸에 든다. 손목이 아니라 허리, 허리가 아니라 발. 어제 몰랐던 반 치가 오늘 손에 있다.
@fx sw:2 hp:-1
@goto #NightEnd
# NSwB3
운검비록 제삼결. 획 하나를 천 번 긋는다. 종이가 아니라 공기에. 공기가 베이는 소리를, 당신은 이제 안다.
@fx sw:2 hp:-1
@goto #NightEnd
# NQi
@set tr=random(1,100)
@goto #NQiT1 if:tn_qi1<1&&day>=5&&tr<=30
@goto #NQiT2 if:tn_qi2<1&&day>=12&&curse>=25&&tr<=30
@goto #NQiB if:f_breath>0
@set sv=random(1,4)
@goto #NQi2 if:sv==2
@goto #NQi3 if:sv==3
@goto #NQi4 if:sv==4
조식(調息), 취기(聚氣), 운기(運氣)… 토탁(吐濁)에서 막힌다. 뱉어야 할 탁기를, 가슴의 <color=#9A70C4>문양이 먼저 삼킨다</color>.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQi2
운기 한 바퀴. 단전에서 올라온 기가 가슴에서 한 번 멈춘다. 문양이 통행세를 받는 자리다. 내고, 지나간다.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQi3
들숨, 날숨. 벽 너머 술꾼들의 노래가 박자가 된다. 강호의 밤에 맞춰 숨 쉬는 법—그것도 운기다. 문양은 제 몫을 챙긴다.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQi4
운기 도중 사형의 목소리가 들린 것 같았다. '막내야, 숨이 급하다.' 숨을 늦춘다. 기가 한 뼘 깊이 내려가고—문양도 한 뼘 따라온다.
@fx ng:2 hp:1 curse:3
@goto #NightEnd
# NQiT1
@set tn_qi1=1
@gosub MolakEvents#T_Qi1
@goto #NightEnd
# NQiT2
@set tn_qi2=1
@gosub MolakEvents#T_Qi2
@goto #NightEnd
# NQiB
@goto #NQiB3 if:f_breath2>0
@set sv=random(1,2)
@goto #NQiB2 if:sv==2
들숨 여섯, 날숨 아홉. 거지 중의 구결대로 숨을 바꾸자, 탁기가 덜 쌓인다.
@fx ng:2 hp:1 curse:2
@goto #NightEnd
# NQiB2
여섯, 아홉. 구결대로 숨을 바꾼다. 문양이 삼키는 몫이 손톱만큼 준다. 손톱만큼이 쌓여 목숨이 된다.
@fx ng:2 hp:1 curse:2
@goto #NightEnd
# NQiB3
여섯, 아홉—그리고 반 호흡의 멈춤. 거지 중의 두 번째 구결. 탁기가 씨앗에 닿기 전에 입에서 나간다. 문양이 굶는다.
@fx ng:2 hp:1 curse:1
@goto #NightEnd
# NightTown
저녁 저자. 등불이 하나둘 켜진다.
@choice "날품을 판다 — 물지게와 장작" goto:#NWork
@choice "상점가를 둘러본다" goto:#Town1
@choice "그냥 돌아간다" goto:#NightEnd
@stop
# NWork
@set tr=random(1,100)
@goto #NWorkT1 if:tn_wk1<1&&day>=6&&tr<=30
@set r=random(2,3)
@set sv=random(1,3)
@goto #NWork2 if:sv==2
@goto #NWork3 if:sv==3
물지게 마흔 번. 어깨에 밧줄 자국. 삯은 정직하고, 정직한 것들은 대개 아프다.
@fx mn:{r} hp:-1
@goto #NightEnd
# NWork2
장작 패기 이백 개. 도끼질에도 검법이 있다—라고 생각하면 덜 지겹다. 삯은 정직하고, 어깨는 아프다.
@fx mn:{r} hp:-1
@goto #NightEnd
# NWork3
저자 창고에서 가마니를 나른다. 창고지기가 당신 손바닥의 굳은살을 보고 품삯을 반 닢 얹어 준다. 손이 이력서다.
@fx mn:{r} hp:-1
@goto #NightEnd
# NWorkT1
@set tn_wk1=1
@gosub MolakEvents#T_Wk1
@goto #NightEnd
# NDuel
저잣거리 공터—비무판. 서열을 건 칼들이 밤마다 부딪치는 곳이다.
@set dkind="any"
@gosub MolakDuel#Run
@goto #NightEnd
# NWolf
@goto Molak04#Wf1
# NRest
@set tr=random(1,100)
@goto #NRestT1 if:tn_rest1<1&&day>=5&&tr<=30
@set sv=random(1,4)
@goto #NRest2 if:sv==2
@goto #NRest3 if:sv==3
@goto #NRest4 if:sv==4
침상에 눕는다. 아무 일도 없는 밤—지금의 당신에게는 그것이 사치다.
@fx hp:3
@goto #NightEnd
# NRest2
일찍 눕는다. 천장의 얼룩을 센다. 일 년 동안 센 얼룩이다. 오늘은 하나가 더 늘어 보인다. 착각일 것이다.
@fx hp:3
@goto #NightEnd
# NRest3
잠이 오지 않아 창을 연다. 달이 마당의 느티나무에 걸려 있다. 아무 일도 없는 밤. 그것이 사치라는 것을 몸이 안다.
@fx hp:3
@goto #NightEnd
# NRest4
점소이가 두고 간 식은 국밥을 마저 먹고 눕는다. 배부른 것도 수련이다—라고 사형이 말했었다. 믿기로 한다.
@fx hp:3
@goto #NightEnd
# NRestT1
@set tn_rest1=1
@gosub MolakEvents#T_Rest1
@goto #NightEnd

# NightEnd
@daytick
@goto MolakOver#Starve if:hp<=0&&starved>0
@goto MolakOver#Exhaust if:hp<=0
@goto MolakOver#Curse if:curse>=100
@goto #D10 if:day==10
@goto #D18 if:day==18
@goto #D25 if:day==25
@goto #D35 if:day==35
@goto #D50 if:day==50
@goto #Evening
# D10
가슴의 문양이, 아무것도 하지 않은 날에도 <color=#9A70C4>조금 자라 있다</color>. 사술은 뿌리를 내렸다. 이제 시간은 당신의 편이 아니다.
@goto #Evening
# D18
가슴의 문양이 <color=#9A70C4>익어간다</color>. 자라는 속도가 눈에 띄게 빨라졌다. 노인의 말이 떠오른다. '다 익으면'—그 다음은, 듣지 못했다.
@goto #Evening
# D25
하진무가 방값 패를 바꿔 단다. "교의 징세가 또 올랐습니다, 객. 내일부터 두 냥입니다." 영감의 셈은 정확하고, 강호의 물가는 무정하다.
@goto #Evening
# D35
한밤중, 가슴이 타는 듯해 눈을 뜬다. 문양이 <color=#9A70C4>스스로 꿈틀거리고 있다</color>. 뿌리가 깊어졌다—이제부터는 하루가 다르게 자랄 것이다. 시간이, 본격적으로 적이 되었다.
@goto #Evening
# D50
문양이 가슴을 넘어 <color=#C03434>쇄골까지 뻗었다</color>. 백초 할멈이 맥을 짚고는 처음으로 말을 아꼈다. 남은 날이—많지 않다.
@goto #Evening
# Evening
@art char:none
@pickevent chance:40 slot:night
@gosub #RunEvent if:nextevent!="none"
@goto #DayLoop

# RunEvent
@gosub MolakEvents#E_Yong if:nextevent=="E_Yong"
